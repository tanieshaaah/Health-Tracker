{
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/landing.html"
    },
    {
      "source": "/app",
      "destination": "/public/index.html"
    },
    {
      "source": "/landing.css",
      "destination": "/public/landing.css"
    },
    {
      "source": "/app.js",
      "destination": "/public/app.js"
    },
    {
      "source": "/auth.js",
      "destination": "/public/auth.js"
    },
    {
      "source": "/styles.css",
      "destination": "/public/styles.css"
    },
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    },
    {
      "source": "/service-worker.js",
      "destination": "/public/service-worker.js"
    },
    {
      "source": "/icon.svg",
      "destination": "/public/icon.svg"
    }
  ]
}
